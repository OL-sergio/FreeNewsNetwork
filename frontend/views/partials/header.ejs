<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@100..900&family=Geist:wght@100..900&display=swap"
      rel="stylesheet"
    />

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.2/font/bootstrap-icons.min.css"
    />
    <link rel="stylesheet" href="/css/main.css" />
  </head>

  <body>
    <header class="container p-0 mt-0" style="background-color: var(--bs-secondary-color)">
      <div
        class="d-flex flex-wrap align-items-center justify-content-center justify-content-lg-start m-0 p-3"
      >
        <a href="/" class="d-flex align-items-center mb-1 mb-lg-0 text-white text-decoration-none">
          <svg class="bi me-2" width="40" height="32" role="img" aria-label="Bootstrap">
            <use xlink:href="#bootstrap"></use>
          </svg>
        </a>
        <ul class="nav col-12 col-lg-auto ms-lg-auto mb-2 justify-content-center mb-md-0 me-2">
          <li><a href="#" class="nav-link px-2 text-info">Home</a></li>
          <li><a href="#" class="nav-link px-2 text-white">Features</a></li>
          <li><a href="#" class="nav-link px-2 text-white">Pricing</a></li>
          <li><a href="#" class="nav-link px-2 text-white">FAQs</a></li>
          <li><a href="#" class="nav-link px-2 text-white">About</a></li>
        </ul>
        <form class="col-12 col-lg-auto mb-3 mb-lg-0 me-lg-2" role="search">
          <input
            type="search"
            class="form-control form-control-plaintext text-bg-fade ps-5 accordion-header border-white border-1 rounded"
            placeholder="Search..."
            aria-label="Search"
          />
        </form>
        <button type="search" aria-label="Search" class="btn btn-outline-light ms-2">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            fill="currentColor"
            class="bi bi-search"
            viewBox="0 0 16 16"
          >
            <path
              d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0"
            />
          </svg>
        </button>
        <div class="text-end">
          <button type="button" class="btn btn-outline-light ms-4">Login</button>
          <button type="button" class="btn btn-light mx-2">Sign-up</button>
        </div>
      </div>
      <div>
        <div
          id="myCarousel"
          class="carousel slide mb-6 d-flex justify-content-start"
          data-bs-ride="carousel"
        >
          <div class="carousel-indicators" style="margin-bottom: 4rem">
            <button
              type="button"
              data-bs-target="#myCarousel"
              data-bs-slide-to="0"
              class="rounded-circle"
              style="width: 0.8rem; height: 0.8rem; margin-left: 0.4rem"
              aria-label="Slide 1"
            ></button>
            <button
              type="button"
              data-bs-target="#myCarousel"
              data-bs-slide-to="1"
              aria-label="Slide 2"
              class="active rounded-circle"
              style="width: 0.8rem; height: 0.8rem; margin-left: 0.8rem"
              aria-current="true"
            ></button>
            <button
              type="button"
              data-bs-target="#myCarousel"
              data-bs-slide-to="2"
              aria-label="Slide 3"
              class="rounded-circle mb-4"
              style="width: 0.8rem; height: 0.8rem; margin-left: 0.8rem"
            ></button>

            <div
              class="d-flex justify-content-center align-items-center gap-2 w-100"
              style="width: 100%; color: white"
            ></div>
          </div>
          <div class="carousel-inner">
            <div class="carousel-item">
              <svg
                aria-hidden="true"
                class="bd-placeholder-img"
                height="100%"
                preserveAspectRatio="xMidYMid slice"
                width="100%"
                xmlns="http://www.w3.org/2000/svg"
                style="height: 36rem"
              >
                <rect
                  width="100%"
                  height="100%"
                  fill="var(--bs-secondary-color)"
                  style="
                    --darkreader-inline-fill: var(
                      --darkreader-bg--bs-secondary-color,
                      var(--darkreader-background-ffffff, #000000)
                    );
                  "
                  data-darkreader-inline-fill=""
                ></rect>
              </svg>
              <div class="container">
                <div class="carousel-caption text-start" style="margin-bottom: 10rem">
                  <h5 class="mb-4 p-3 news-type">Tipo noticia</h5>
                  <h1 class="mb-4">Example headline.</h1>
                  <p class="d-flex justify-content-start align-items-center gap-2">
                    <a> 23/04/2023 </a>
                    <span class="d-inline-block dividers-sub-title" aria-hidden="true"></span>
                    Some representative placeholder content for the first slide of the carousel.
                  </p>
                </div>
              </div>
            </div>
            <div class="carousel-item active">
              <svg
                aria-hidden="true"
                class="bd-placeholder-img"
                height="100%"
                preserveAspectRatio="xMidYMid slice"
                width="100%"
                xmlns="http://www.w3.org/2000/svg"
                style="height: 36rem"
              >
                <rect
                  width="100%"
                  height="100%"
                  fill="var(--bs-secondary-color)"
                  style="
                    --darkreader-inline-fill: var(
                      --darkreader-text--bs-secondary-color,
                      var(--darkreader-text-000000, #ffffff)
                    );
                  "
                  data-darkreader-inline-fill=""
                ></rect>
              </svg>
              <div class="container">
                <div class="carousel-caption text-start" style="margin-bottom: 10rem">
                  <h5 class="mb-4 p-3 news-type">Tipo noticia</h5>
                  <h1 class="mb-4">Another example headline.</h1>
                  <p class="d-flex justify-content-start align-items-center gap-2">
                    <a> 23/04/2023 </a>
                    <span class="d-inline-block dividers-sub-title" aria-hidden="true"></span>
                    Some representative placeholder content for the second slide of the carousel.
                  </p>
                </div>
              </div>
            </div>
            <div class="carousel-item">
              <svg
                aria-hidden="true"
                class="bd-placeholder-img"
                height="100%"
                preserveAspectRatio="xMidYMid slice"
                width="100%"
                xmlns="http://www.w3.org/2000/svg"
                style="height: 36rem"
              >
                <rect
                  width="100%"
                  height="100%"
                  fill="var(--bs-secondary-color)"
                  style="
                    --darkreader-inline-fill: var(
                      --darkreader-text--bs-secondary-color,
                      var(--darkreader-text-000000, #ffffff)
                    );
                  "
                  data-darkreader-inline-fill=""
                ></rect>
              </svg>
              <div class="container">
                <div class="carousel-caption text-start" style="margin-bottom: 10rem">
                  <h5 class="mb-4 p-3 news-type">Tipo noticia</h5>
                  <h1 class="mb-4">One more for good measure.</h1>
                  <p class="d-flex justify-content-start align-items-center gap-2">
                    <a> 23/04/2023 </a>
                    <span class="d-inline-block dividers-sub-title" aria-hidden="true"></span>
                    Some representative placeholder content for the third slide of this carousel.
                  </p>
                </div>
              </div>
            </div>
          </div>
          <button
            class="carousel-control-prev"
            type="button"
            data-bs-target="#myCarousel"
            data-bs-slide="prev"
            style="width: 7rem"
          >
            <span class="carousel-control-prev-icon" aria-hidden="true" hidden></span>
            <span class="visually-hidden">Previous</span>
          </button>
          <button
            class="carousel-control-next"
            type="button"
            data-bs-target="#myCarousel"
            data-bs-slide="next"
            style="width: 7rem"
          >
            <span class="carousel-control-next-icon" aria-hidden="true" hidden></span>
            <span class="visually-hidden">Next</span>
          </button>
        </div>
      </div>
    </header>
