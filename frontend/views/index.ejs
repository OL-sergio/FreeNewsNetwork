      <div class="col">
        <div
          class="card card-cover overflow-hidden text-bg-dark rounded-3 shadow-lg"
          style="background-image: url('unsplash-photo-3.jpg')"
        >
          <div class="d-flex flex-column h-100 p-5 pb-3 text-shadow-1">
            <h5 class="p-1 mt-1 mb-0 lh-1 align-self-md-end ou">Technology</h5>
            <h5 class="pt-5 mt-4 mb-1 lh-1">08.08.2024</h5>
            <h3 class="pt-1 mt-1 mb-4 lh-1 fw-bold">Another longer title belongs here</h3>
            <ul class="d-flex list-unstyled mt-auto">
              <li class="d-flex align-items-start me-3 pb-5">
                <h6 style="line-height: 1.8; font-size: 1rem">
                  California CaliforniaCaliforniaCaliforniaCalifornia
                  CaliforniaCaliforniaCaliforniaCalifornia
                </h6>
              </li>
            </ul>
          </div>
        </div>
      </div>
      <div class="col">
